# Copy to .env.local and fill in from Firebase console > Project settings > Your apps (Web app).
# The Firebase web config is not a secret, but keep .env.local out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic).
# Production / hosted demo: reCAPTCHA Enterprise site key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local development only: leave empty to let the SDK print a debug token in the console,
# then register it in Firebase console > App Check > Apps > Manage debug tokens.
# No VITE_ prefix on purpose: it is injected by the dev server only and can never reach a
# production build (npm run build checks it).
APPCHECK_DEBUG_TOKEN=

# Cloud model used for the 90-day plan and the letter template.
VITE_CLOUD_MODEL=gemini-3.5-flash-lite
